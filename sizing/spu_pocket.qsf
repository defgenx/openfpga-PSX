# Standalone fit of rtl/spu_pocket.vhd (docs/pocket/SPU.md): same device and wrapper rules as spu_golden.qsf.
# G_NO_REVERB true and G_L1_CACHE true: the gating configuration. Set G_NO_REVERB false for the reverb-on build.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA4F23C8
set_global_assignment -name TOP_LEVEL_ENTITY spu_pocket_size_wrap
set_global_assignment -name NUM_PARALLEL_PROCESSORS 1
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_spu_pocket
set_parameter -name G_NO_REVERB true
set_global_assignment -name VHDL_FILE ../rtl/SyncFifo.vhd
set_global_assignment -name VHDL_FILE ../rtl/SyncFifoFallThrough.vhd
set_global_assignment -name VHDL_FILE ../rtl/SyncFifoFallThroughMLAB.vhd
set_global_assignment -name VHDL_FILE ../rtl/SyncRam.vhd
set_global_assignment -name VHDL_FILE ../rtl/SyncRamDual.vhd
set_global_assignment -name VHDL_FILE ../rtl/SyncRamDualNotPow2.vhd
set_global_assignment -name VHDL_FILE ../rtl/SyncRamDualByteEnable.vhd
set_global_assignment -name VHDL_FILE ../rtl/dpram.vhd
set_global_assignment -name VHDL_FILE ../rtl/RamMLAB.vhd
set_global_assignment -name VHDL_FILE ../rtl/spu_pocket_gauss.vhd
set_global_assignment -name VHDL_FILE ../rtl/spu_pocket_sdp.vhd
set_global_assignment -name VHDL_FILE ../rtl/spu_pocket_fifo.vhd
set_global_assignment -name VHDL_FILE ../rtl/spu_pocket_ram.vhd
set_global_assignment -name VHDL_FILE ../rtl/spu_pocket.vhd
set_global_assignment -name VHDL_FILE spu_pocket_size_wrap.vhd
set_global_assignment -name SDC_FILE spu.sdc
set_instance_assignment -name VIRTUAL_PIN ON -to i_*
set_instance_assignment -name VIRTUAL_PIN ON -to o_*

set_global_assignment -name LAST_QUARTUS_VERSION "21.1.1 Lite Edition"

# Fitter seed 1 leaves 0.061 ns of hold violation (Fast 0C, gauss table to multiplier); seeds 2 and 3 meet.
set_global_assignment -name SEED 3
