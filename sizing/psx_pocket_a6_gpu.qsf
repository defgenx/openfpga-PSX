# In-context fit of gpu_pocket (G_GPU_IMPL pocket) with the B6 units, which psx_pocket_a6.qsf does not list yet.
# The golden GPU in the same context is G_GPU_IMPL golden (4,620 ALMs for gpu_pocket before B6, docs/pocket/GPU.md).
source psx_pocket_a6.qsf
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_psx_pocket_a6_gpu
set_parameter -name G_GPU_IMPL pocket
set_global_assignment -name VHDL_FILE ../rtl/gpu_rect_pocket.vhd
set_global_assignment -name VHDL_FILE ../rtl/gpu_copy_pocket.vhd
set_global_assignment -name VHDL_FILE ../rtl/gpu_videoout_pocket.vhd
