set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA4F23C8
set_global_assignment -name TOP_LEVEL_ENTITY cpu_size_wrap
set_global_assignment -name NUM_PARALLEL_PROCESSORS 1
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_cpu_golden
set_global_assignment -name VHDL_FILE ../rtl/SyncFifo.vhd
set_global_assignment -name VHDL_FILE ../rtl/SyncFifoFallThrough.vhd
set_global_assignment -name VHDL_FILE ../rtl/SyncFifoFallThroughMLAB.vhd
set_global_assignment -name VHDL_FILE ../rtl/SyncRam.vhd
set_global_assignment -name VHDL_FILE ../rtl/SyncRamDual.vhd
set_global_assignment -name VHDL_FILE ../rtl/SyncRamDualNotPow2.vhd
set_global_assignment -name VHDL_FILE ../rtl/SyncRamDualByteEnable.vhd
set_global_assignment -name VHDL_FILE ../rtl/dpram.vhd
set_global_assignment -name VHDL_FILE ../rtl/RamMLAB.vhd
set_global_assignment -name VHDL_FILE ../rtl/export.vhd
set_global_assignment -name VHDL_FILE ../rtl/divider.vhd
set_global_assignment -name VHDL_FILE ../rtl/datacache.vhd
set_global_assignment -name VHDL_FILE ../rtl/cpu.vhd
set_global_assignment -name VHDL_FILE cpu_size_wrap.vhd
set_global_assignment -name SDC_FILE cpu.sdc
set_instance_assignment -name VIRTUAL_PIN ON -to i_*
set_instance_assignment -name VIRTUAL_PIN ON -to o_*

set_global_assignment -name LAST_QUARTUS_VERSION "21.1.1 Lite Edition"
