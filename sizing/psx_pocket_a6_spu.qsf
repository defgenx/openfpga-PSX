# In-context fit of rtl/spu_pocket.vhd (docs/pocket/SPU.md): psx_top_pocket with G_SPU_IMPL = pocket, the golden SPU left in
# the file list because psx_top_pocket instantiates it through G_SPU_IMPL = golden (the generate is not elaborated).
source psx_pocket_a6.qsf
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_psx_pocket_a6_spu
set_parameter -name G_SPU_IMPL pocket
set_global_assignment -name VHDL_FILE ../rtl/spu_pocket_gauss.vhd
set_global_assignment -name VHDL_FILE ../rtl/spu_pocket_sdp.vhd
set_global_assignment -name VHDL_FILE ../rtl/spu_pocket_fifo.vhd
set_global_assignment -name VHDL_FILE ../rtl/spu_pocket_ram.vhd
set_global_assignment -name VHDL_FILE ../rtl/spu_pocket.vhd
