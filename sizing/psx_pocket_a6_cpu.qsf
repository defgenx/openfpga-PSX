# cpu_pocket in the Pocket top (G_CPU_IMPL pocket); the gate metric (docs/pocket/CPU.md) is "ALMs needed" of cpu_pocket:icpu here.
source psx_pocket_a6.qsf
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_psx_pocket_a6_cpu
set_parameter -name G_CPU_IMPL pocket
set_global_assignment -name VHDL_FILE ../rtl/divider_pocket.vhd
set_global_assignment -name VHDL_FILE ../rtl/cpu_pocket.vhd
