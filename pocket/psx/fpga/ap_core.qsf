set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to dram_dq[*]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to dram_dq[*]

# generated PLL (tools/gen_pll.sh); the IP generator's own assignments
set_instance_assignment -name PLL_COMPENSATION_MODE DIRECT -to "*pll_psx_dps*|altera_pll:altera_pll_i*|*"
set_instance_assignment -name UNFORCE_MERGE_PLL_OUTPUT_COUNTER ON -to "*pll_psx_dps*|altera_pll:altera_pll_i*|*"

