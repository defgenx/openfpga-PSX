// Shared memory-controller constants: clock variant and SDRAM cycle counts. See docs/pocket/MEMTEST.md.
`ifndef MEM_DEFS_VH
`define MEM_DEFS_VH

// ---- clock variant: the one place that selects the system clock and its SDRAM cycle counts
// Default build 101.6064 MHz; `SDRAM_135` (Quartus VERILOG_MACRO, or -DSDRAM_135 in simulation) 135.4752 MHz.
// The SDRAM cycle counts and the clock (MT_CLK_HZ, MT_TCK_PS) come from sdram_timing.vh (generated by tools/sdram_timing.py).
`include "sdram_timing.vh"
`ifdef SDRAM_135
  `define MT_SD_INIT    `SDT_135_INIT
  `define MT_SD_REF     `SDT_135_REF
  `define MT_SD_TRCD    `SDT_135_TRCD
  `define MT_SD_TRP     `SDT_135_TRP
  `define MT_SD_TRAS    `SDT_135_TRAS
  `define MT_SD_TRC     `SDT_135_TRC
  `define MT_SD_TRFC    `SDT_135_TRFC
  `define MT_SD_TWR     `SDT_135_TWR
  `define MT_SD_TRRD    `SDT_135_TRRD
  `define MT_SD_TMRD    `SDT_135_TMRD
`else
  `define MT_SD_INIT    `SDT_101_INIT
  `define MT_SD_REF     `SDT_101_REF
  `define MT_SD_TRCD    `SDT_101_TRCD
  `define MT_SD_TRP     `SDT_101_TRP
  `define MT_SD_TRAS    `SDT_101_TRAS
  `define MT_SD_TRC     `SDT_101_TRC
  `define MT_SD_TRFC    `SDT_101_TRFC
  `define MT_SD_TWR     `SDT_101_TWR
  `define MT_SD_TRRD    `SDT_101_TRRD
  `define MT_SD_TMRD    `SDT_101_TMRD
`endif

// Cycles of the system clock that cover ns10 / 10 ns. Every wait or window that is a time rather than
// a protocol cycle count is written through this, so both clock variants keep the same ns.
`define MT_CYC(ns10) (((ns10) * 100 + `MT_TCK_PS - 1) / `MT_TCK_PS)

`endif
